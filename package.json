{
  "name": "chorm",
  "version": "0.0.0",
  "description": "A typesafe, Effect-native ClickHouse ORM with schema introspection and codegen.",
  "keywords": [
    "clickhouse",
    "codegen",
    "effect",
    "orm",
    "query-builder",
    "schema",
    "typesafe",
    "typescript"
  ],
  "license": "MIT",
  "bin": {
    "chorm": "./dist/cli.mjs"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "@clickhouse/client": "^1.19.0",
    "effect": "^3.21.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "bumpp": "^11.1.0",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.20"
  },
  "packageManager": "pnpm@11.5.0"
}
